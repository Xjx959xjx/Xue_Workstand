{
  "name": "account-style-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:sandbox": "node scripts/dev-sandbox.mjs",
    "dev:sites": "vinext dev -p 3001",
    "dev:daemon": "node scripts/dev-server.mjs start",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "remote:setup": "node scripts/remote-server.mjs setup",
    "remote:start": "node scripts/remote-server.mjs start",
    "remote:stop": "node scripts/remote-server.mjs stop",
    "remote:status": "node scripts/remote-server.mjs status",
    "remote:dev": "node scripts/remote-server.mjs dev",
    "remote:deploy": "node scripts/remote-server.mjs deploy",
    "remote:rollback": "node scripts/remote-server.mjs rollback",
    "capability:setup": "node scripts/capability-bridge-service.mjs setup",
    "capability:status": "node scripts/capability-bridge-service.mjs status",
    "build": "next build",
    "build:sites": "vinext build && node scripts/prepare-sites-output.mjs",
    "start:sites": "wrangler dev --config dist/server/wrangler.json",
    "check:sites": "node scripts/check-sites-compatibility.mjs",
    "check:sites:release": "node scripts/check-sites-release.mjs",
    "prepare:sites:migration": "node scripts/prepare-sites-library-migration.mjs",
    "db:generate": "drizzle-kit generate",
    "package:release": "node scripts/package-release.mjs",
    "start": "next start",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "metrics:pipeline": "node scripts/report-pipeline-metrics.mjs",
    "eval:writer": "promptfoo eval -c evals/promptfooconfig.yaml --no-share",
    "eval:writer:view": "promptfoo view",
    "check:library": "node scripts/check-library-consistency.mjs",
    "check:library:repair": "node scripts/check-library-consistency.mjs --repair",
    "engagement:refresh-style": "node scripts/refresh-engagement-comment-benchmarks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.23",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "rss-parser": "^3.13.0",
    "undici": "^8.10.0",
    "vinext": "1.0.0-beta.8",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/eslintrc": "^3.2.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.60.0",
    "promptfoo": "^0.123.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "docx": {
      "nanoid": "5.1.16"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}

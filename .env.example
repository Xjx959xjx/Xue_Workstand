APP_MODE=workspace
APP_START_PATH=/douyin-hotlist
OPENCLI_BIN=opencli
OPENCLI_WINDOW=background
OPENCLI_BROWSER_SESSION=content-workbench-browser
# 多个 Chrome profile 同时启用 Browser Bridge 时，可填写 opencli profile list 中的别名或 contextId 固定路由。
OPENCLI_PROFILE=
FFMPEG_BIN=ffmpeg
STYLE_LIBRARY_DIR=./style-library
PINO_LOG_LEVEL=info
# Optional Stirling-PDF instance used by the /tools workspace. Docker default: http://localhost:8080
NEXT_PUBLIC_STIRLING_PDF_URL=http://localhost:8080
# Sites cloud runtime. Leave unset for the local filesystem mode.
SITES_STORAGE_MODE=
# Optional authenticated HTTP bridge for OpenCLI/FFmpeg/ASR/document capabilities.
SITES_EXTERNAL_CAPABILITY_URL=
SITES_EXTERNAL_CAPABILITY_TOKEN=
# Capability-provider host only. Keep these unset in the Sites Worker.
SITES_CAPABILITY_BRIDGE_TOKEN=
SITES_CAPABILITY_BRIDGE_PUBLIC_URL=
SITES_CAPABILITY_BRIDGE_TIMEOUT_MS=1200000
SITES_CAPABILITY_BRIDGE_BODY_LIMIT_BYTES=2097152
SITES_CAPABILITY_BRIDGE_ASSET_TTL_MS=600000
# Optional live account source for the gross-margin workspace. When set, the app reads
# the Douyin/Bilibili account pairing and prices from this WeCom sheet via wecom-cli.
WECOM_ACCOUNT_SHEET_URL=
WECOM_CLI_BIN=wecom-cli
WECOM_ACCOUNT_SHEET_CACHE_TTL_MS=300000
WECOM_ACCOUNT_SHEET_FALLBACK_LOCAL=1
# Background task scheduler. History is bounded by count and disk size; oversized terminal results are compacted on disk.
JOB_MAX_ACTIVE=2
JOB_HISTORY_LIMIT=200
JOB_HISTORY_MAX_MB=20
JOB_RESULT_PERSIST_KB=96
# Gross-margin monitor refresh concurrency. Keep at 1-6; default is 6.
GROSS_MARGIN_MONITOR_REFRESH_CONCURRENCY=6

# Volcengine recording-file recognition 2.0
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCENGINE_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
VOLCENGINE_ASR_AUDIO_FORMAT=mp3
VOLCENGINE_ASR_POLL_INTERVAL_MS=1000
VOLCENGINE_ASR_MAX_POLL_ATTEMPTS=120
VOLCENGINE_ASR_REQUEST_TIMEOUT_MS=30000
VOLCENGINE_ASR_RETRY_COUNT=2
# Douyin batch transcription concurrency. Keep at 1-4; default is 3.
DOUYIN_TRANSCRIBE_CONCURRENCY=3
# Video hotlist account refresh concurrency. Keep at 1-5; default is 2.
# The variable name is kept for compatibility with the old Douyin-only hotlist.
DOUYIN_HOTLIST_REFRESH_CONCURRENCY=2

# Primary chat endpoint for style extraction and copywriting.
# For OpenAI-compatible relays, set CHAT_WIRE_API=chat_completions or auto.
# CHAT_BASE_URL can be a host root such as https://api.example.com/v1, or use the explicit endpoint overrides below.
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_RESPONSES_URL=
CHAT_COMPLETIONS_URL=
CHAT_MODEL=
CHAT_WIRE_API=auto
CHAT_REASONING_EFFORT=none
CHAT_SERVICE_TIER=
# Fallback chat endpoint. Defaults to the previous relay/model; fill a separate key to enable it.
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_BASE_URL=https://www.fhl.mom
CHAT_FALLBACK_RESPONSES_URL=
CHAT_FALLBACK_COMPLETIONS_URL=
CHAT_FALLBACK_MODEL=gpt-5.5
CHAT_FALLBACK_WIRE_API=responses
CHAT_FALLBACK_REASONING_EFFORT=xhigh
CHAT_FALLBACK_SERVICE_TIER=
CHAT_FALLBACK_PROXY_URL=
CHAT_FALLBACK_ENABLED=1
# Additional fallback endpoints are tried in numeric order after CHAT_FALLBACK_*.
# Repeat the same suffixes with CHAT_FALLBACK_3_*, CHAT_FALLBACK_4_* or CHAT_FALLBACK_5_* when needed.
CHAT_FALLBACK_2_API_KEY=
CHAT_FALLBACK_2_BASE_URL=
CHAT_FALLBACK_2_RESPONSES_URL=
CHAT_FALLBACK_2_COMPLETIONS_URL=
CHAT_FALLBACK_2_MODEL=
CHAT_FALLBACK_2_WIRE_API=auto
CHAT_FALLBACK_2_REASONING_EFFORT=
CHAT_FALLBACK_2_SERVICE_TIER=
CHAT_FALLBACK_2_PROXY_URL=
CHAT_FALLBACK_2_ENABLED=1
# Optional: make server-side model requests use the local FlClash proxy.
CHAT_PROXY_URL=http://127.0.0.1:7890
# Model health probe timeout. Clamped to 2000-30000ms; default is 8000.
CHAT_HEALTH_PROBE_TIMEOUT_MS=8000
# Dedicated Responses API endpoint for writer web research. This stays separate from
# the Chat Completions writing route; WEB_RESEARCH_API_KEY must be set to enable it.
WEB_RESEARCH_ENABLED=1
WEB_RESEARCH_API_KEY=
WEB_RESEARCH_BASE_URL=https://api.openai.com/v1
WEB_RESEARCH_RESPONSES_URL=
WEB_RESEARCH_MODEL=gpt-6
WEB_RESEARCH_REASONING_EFFORT=low
WEB_RESEARCH_SERVICE_TIER=
WEB_RESEARCH_PROXY_URL=http://127.0.0.1:7890
# Read complete originals and cache validated purpose/evidence analyses before summarizing a style card.
# Keep concurrency at 1 for strict relay limits. STYLE_ONE_SHOT_MAX_INPUT_CHARS is no longer used.
STYLE_SAMPLE_ANALYSIS_CONCURRENCY=2
# Engagement comment generation concurrency. Keep at 1-4 to avoid model relay throttling.
ENGAGEMENT_MODEL_CONCURRENCY=4
ENGAGEMENT_COMMENT_CANDIDATE_RATIO=1.4
# Bounded offline benchmark refresh. Generation reads this local cache and never scans the web inline.
ENGAGEMENT_BENCHMARK_BILIBILI_HOT_LIMIT=6
ENGAGEMENT_BENCHMARK_BILIBILI_VIDEOS_PER_QUERY=3
ENGAGEMENT_BENCHMARK_BILIBILI_VIDEO_LIMIT=36
ENGAGEMENT_BENCHMARK_BILIBILI_COMMENT_LIMIT=30
ENGAGEMENT_BENCHMARK_BILIBILI_DANMAKU_LIMIT=180
ENGAGEMENT_BENCHMARK_BILIBILI_DIGITAL_VIDEO_SHARE=0.67
ENGAGEMENT_BENCHMARK_BILIBILI_ACCOUNT_VIDEO_LIMIT=2
ENGAGEMENT_BENCHMARK_BILIBILI_REQUEST_INTERVAL_MS=750
ENGAGEMENT_BENCHMARK_DOUYIN_VIDEO_LIMIT=12
ENGAGEMENT_BENCHMARK_DOUYIN_COMMENT_LIMIT=10
ENGAGEMENT_BENCHMARK_DOUYIN_SEARCH_VIDEOS_PER_QUERY=1
ENGAGEMENT_BENCHMARK_DOUYIN_SEARCH_COMMENT_LIMIT=20
# Optional comma-separated topic:query entries. Bilibili defaults reserve about two thirds of videos for digital verticals.
ENGAGEMENT_BENCHMARK_BILIBILI_QUERIES=
# Optional comma-separated trusted Bilibili creator names used to prefer real editorial/review channels over SEO result farms.
ENGAGEMENT_BENCHMARK_BILIBILI_PREFERRED_ACCOUNTS=
ENGAGEMENT_BENCHMARK_DOUYIN_QUERIES=
# Optional comma-separated name:sec_uid entries appended in place of the built-in bounded Douyin account seeds.
ENGAGEMENT_BENCHMARK_DOUYIN_ACCOUNTS=
# OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL are also accepted for the primary chat endpoint.

# Image endpoint for Bilibili cover generation.
# Defaults to OpenAI Images API with GPT Image 2.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=2048x1152
IMAGE_QUALITY=medium
IMAGE_FORMAT=jpeg
IMAGE_PROXY_URL=http://127.0.0.1:7890

# Optional: publish generated copy to Feishu Docs.
# By default the app uses your existing opencli lark-cli login as user.
FEISHU_OPENCLI_AS=user
# Optional folder token. Leave empty to create in the app default location.
FEISHU_FOLDER_TOKEN=

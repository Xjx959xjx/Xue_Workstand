[{"index": 1, "from": "0.00s", "to": "1.20s", "content": "无敌不玩流风"}, {"index": 2, "from": "1.20s", "to": "3.64s", "content": "傲的人生注定会度过一个失败的人生"}, {"index": 3, "from": "3.64s", "to": "5.18s", "content": "对这句话说的非常好"}, {"index": 4, "from": "5.18s", "to": "6.54s", "content": "这就是顶流主播的自信吗"}, {"index": 5, "from": "6.54s", "to": "8.42s", "content": "楚河参加流放之路BD大赛竞速"}, {"index": 6, "from": "8.42s", "to": "9.52s", "content": "一上来就口出狂言"}, {"index": 7, "from": "9.52s", "to": "11.80s", "content": "如果对这种游戏的理解的话"}, {"index": 8, "from": "11.80s", "to": "13.67s", "content": "一般我入手一个小时"}, {"index": 9, "from": "13.67s", "to": "16.29s", "content": "应该能吊打那些入手五百五百小时的人"}, {"index": 10, "from": "16.29s", "to": "17.45s", "content": "结果实际上手忙脚乱"}, {"index": 11, "from": "17.45s", "to": "17.89s", "content": "拉完了"}, {"index": 12, "from": "17.89s", "to": "20.07s", "content": "我们先看一下楚老师的视角"}, {"index": 13, "from": "20.07s", "to": "21.07s", "content": "我找一下地图"}, {"index": 14, "from": "21.07s", "to": "23.60s", "content": "哎哎哎又着了"}, {"index": 15, "from": "23.60s", "to": "25.50s", "content": "这不是我王大总攻"}, {"index": 16, "from": "25.50s", "to": "27.36s", "content": "必定完了"}, {"index": 17, "from": "28.44s", "to": "30.40s", "content": "我要嘎了"}, {"index": 18, "from": "32.04s", "to": "33.64s", "content": "还有散打吗"}, {"index": 19, "from": "33.64s", "to": "35.60s", "content": "还带了闪打"}, {"index": 20, "from": "37.92s", "to": "39.08s", "content": "要躲一下技能啊"}, {"index": 21, "from": "39.08s", "to": "40.44s", "content": "躲一下火球"}, {"index": 22, "from": "46.94s", "to": "49.82s", "content": "走位非常神木哈哈"}, {"index": 23, "from": "49.82s", "to": "50.42s", "content": "他不下来"}, {"index": 24, "from": "50.42s", "to": "51.28s", "content": "他不下来"}, {"index": 25, "from": "51.28s", "to": "52.06s", "content": "吓我一跳"}, {"index": 26, "from": "52.06s", "to": "52.38s", "content": "血"}, {"index": 27, "from": "52.38s", "to": "54.26s", "content": "later被收为"}, {"index": 28, "from": "58.80s", "to": "60.02s", "content": "OK没毛病啊"}, {"index": 29, "from": "60.02s", "to": "63.52s", "content": "打都有3分10秒给楚河自己都打笑了"}, {"index": 30, "from": "63.52s", "to": "64.34s", "content": "我真的不认识"}, {"index": 31, "from": "64.34s", "to": "66.70s", "content": "本以为这下会被老玩家当减速带碾过去"}, {"index": 32, "from": "66.70s", "to": "68.24s", "content": "可没想到竟是顽童戏老总"}, {"index": 33, "from": "68.24s", "to": "68.98s", "content": "真的假的"}, {"index": 34, "from": "68.98s", "to": "70.30s", "content": "你知道你能打多久啊"}, {"index": 35, "from": "70.30s", "to": "71.78s", "content": "3分41秒啊"}, {"index": 36, "from": "71.78s", "to": "73.70s", "content": "3分41秒数大是多少"}, {"index": 37, "from": "73.70s", "to": "74.46s", "content": "我的舍友"}, {"index": 38, "from": "74.46s", "to": "75.34s", "content": "我的舍友说"}, {"index": 39, "from": "75.34s", "to": "76.24s", "content": "你太懂事了"}, {"index": 40, "from": "76.24s", "to": "77.64s", "content": "我真没商务啊"}, {"index": 41, "from": "77.64s", "to": "79.66s", "content": "兄弟们不至于商务啊"}, {"index": 42, "from": "79.66s", "to": "80.20s", "content": "我跟你说"}, {"index": 43, "from": "80.20s", "to": "81.06s", "content": "我商务会被困"}, {"index": 44, "from": "81.06s", "to": "83.05s", "content": "早会被学习会慢的人坏了"}, {"index": 45, "from": "83.05s", "to": "83.97s", "content": "兄弟这下好了"}, {"index": 46, "from": "83.97s", "to": "84.69s", "content": "压力太大了"}, {"index": 47, "from": "84.69s", "to": "85.83s", "content": "好没关系没关系"}, {"index": 48, "from": "85.83s", "to": "86.41s", "content": "惜败啊"}, {"index": 49, "from": "86.41s", "to": "87.92s", "content": "兄弟们惜败惜败惜败惜败"}, {"index": 50, "from": "87.92s", "to": "89.88s", "content": "只能说大神们的BD还是太权威了"}, {"index": 51, "from": "89.88s", "to": "92.08s", "content": "就算是新手照抄也能轻松赶上老玩家"}, {"index": 52, "from": "92.08s", "to": "93.90s", "content": "那可以用一下我这个比例"}, {"index": 53, "from": "93.90s", "to": "96.04s", "content": "然后这也是我严选自"}, {"index": 54, "from": "96.04s", "to": "98.94s", "content": "就是原味一手新手开荒比例啊"}, {"index": 55, "from": "98.94s", "to": "100.16s", "content": "叫无胜霹雳斩"}, {"index": 56, "from": "100.16s", "to": "101.88s", "conten
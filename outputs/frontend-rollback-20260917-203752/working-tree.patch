+/* Direct-use tools: compact controls, with results shown only when available. */
+.tools-page { width: 100%; align-content: start; gap: var(--space-5); }
+.tools-modules { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; gap: var(--space-5); width: 100%; margin: 0; }
+.tools-utility-column { display: grid; gap: var(--space-5); min-width: 0; }
+.tools-module.panel { padding: 0; min-width: 0; overflow: hidden; border-radius: var(--radius-xl); background: var(--panel); box-shadow: var(--shadow-soft); transition: border-color var(--motion-base) var(--ease-apple), box-shadow var(--motion-base) var(--ease-apple); }
+.tools-module:focus-within { border-color: var(--line-strong); }
+.tools-control-pane { display: grid; align-content: start; min-width: 0; gap: var(--space-5); padding: var(--space-6); }
+.tools-pane-heading { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
+.tools-module-icon { display: grid; place-items: center; flex: 0 0 46px; height: 46px; border-radius: var(--radius-md); background: var(--panel-soft); color: var(--text-strong); box-shadow: var(--surface-inset-highlight); }
+.tools-publish-workspace .tools-module-icon { color: var(--accent-strong); background: var(--accent-tint); }
+.tools-pane-heading h2 { margin: 0; color: var(--text-strong); font-size: var(--text-section-title); font-weight: var(--font-weight-heading); letter-spacing: -0.025em; }
+.tools-pane-heading p { margin: var(--space-1) 0 0; color: var(--muted); font-size: var(--text-meta); }
+.tools-module .btn { border-radius: var(--radius-md); }
+.tools-module .btn.primary { background: var(--control-hero-bg); color: var(--control-primary-text); border-color: var(--text-strong); }
+.tools-module .btn.primary:hover:not(:disabled) { background: var(--control-hero-hover-bg); }
+.tools-module .btn:active:not(:disabled) { transform: scale(0.98); }
+.tools-result-pane { min-width: 0; padding: 0 var(--space-6) var(--space-6); animation: page-content-enter var(--motion-base) var(--ease-apple) both; }
